# Copy to .env (cp .env.example .env). .env is gitignored.
# Every value below has the same default in docker-compose.yml, so the stack
# also starts without a .env file. These are local development placeholders,
# not real secrets: never put real credentials in this file.

# --- Postgres ---
DB_NAME=payments
DB_USER=payments
DB_PASSWORD=payments

# --- Meridian (server-to-server, as seen from inside the compose network) ---
# Local default: the Meridian mock. For the real sandbox set the sandbox URL,
# your API key and webhook secret, and a public CALLBACK_URL (for example via ngrok).
MERIDIAN_BASE_URL=http://meridian-mock:9090
MERIDIAN_API_KEY=mock-api-key
MERIDIAN_WEBHOOK_SECRET=local-dev-webhook-secret
CALLBACK_URL=http://payments-api:8080/webhooks/meridian

# --- Payment rules ---
SUPPORTED_CURRENCIES=GBP,EUR,USD,CAD,AUD,CHF,SEK,NOK,DKK,PLN
MAX_PAYMENT_AMOUNT=10000.00
# Browser origin allowed to call the API (the UI).
CORS_ALLOWED_ORIGIN=http://localhost:3000

# --- Mock only ---
# Origin allowed to call the mock from a browser. Not used by the UI today (the UI only calls the API).
MOCK_ALLOWED_ORIGIN=http://localhost:3000
# Delay before the mock reports ACCP/RJCT, and before ACCP becomes ACSC.
MOCK_AUTH_DELAY_MS=10000
MOCK_SETTLE_AFTER_SECONDS=30
# Chaos switches: send every callback twice, or deliver callbacks with random delays (out of order).
MOCK_DUPLICATE_WEBHOOKS=false
MOCK_OUT_OF_ORDER=false

# --- UI (read when the UI container starts; must be reachable from the user's browser) ---
PAYMENTS_API_URL=http://localhost:8080
